# Private notes and material that is not ours to publish (see NOTICE.md)
DTD_GUIDE.md
DTD_SIMPLE_EXAMPLES.md
Phantom-Books-Real-Books/
.dtd-file-examples/
docs/upstream/

# Anything that is not a -dtd artifact under the resolved trees
# (the originals of the MIT upstream are never committed here)
commands/*
!commands/*-dtd.md
!commands/RoT-DtD-Commander-Adiutor.md
skills/*
!skills/*-dtd/
agents/*
!agents/*-dtd.md
!agents/dtd-contract-auditor.md
!agents/dtd-command-inventory.md

# Tooling
node_modules/
*.tgz
.DS_Store
Thumbs.db
desktop.ini
# the hosted archives checker/pack-claude-ai.mjs writes; a git add -A must never sweep one in (fifth companion pass)
dist/
*.rot-dtd-commander.*.bak

# The scratch worktrees of /deep-scratch-dtd (lib/scratch.mjs open); each is a
# branch of this repository checked out under here, never content of its own.
.claude/worktrees/

# The codemap tool caches an index beside the tree; it is not the tree.
.codemap/

# the memory plugin writes its own CLAUDE.md and .claude/ beside any file it recalls; neither is this repository
**/artifacts/**/CLAUDE.md
**/artifacts/**/.claude/
**/artifacts/**/.rot-moe/
# The RoT MoE plugin's state, written where a session runs, the repository
# root included; the repository's own rule covers it, never the one-line
# .gitignore the plugin writes inside (seventeenth companion pass).
.rot-moe/

# Session content, never source: the cache a gated command saves on the save
# choice of its gate (cc-cache.dtd, lib/cache.mjs) and the run record the sigil
# census writes (lib/sigil.mjs). A save inside a work tree must not land in a
# commit (eleventh companion pass).
artifacts/cache/
artifacts/sigil/
# The companion runner's raw JSON transcript; the markdown record beside it
# is tracked and written by the runner with its header (fourteenth pass).
artifacts/research/companion-*.json
artifacts/research/companion-*.md.tmp
