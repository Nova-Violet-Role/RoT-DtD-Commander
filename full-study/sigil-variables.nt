catalogue:
    topic-1-shell-expansion:
        - ${var:-word}
        - ${var-word}
        - ${var:=word}
        - ${var:?msg}
        - ${var:+word}
        - ${#var}
        - ${var:offset:length}
        - ${var#pat}
        - ${var##pat}
        - ${var%pat}
        - ${var%%pat}
        - ${var/pat/rep}
        - ${var//pat/rep}
        - ${var^}
        - ${var^^}
        - ${var,,}
        - ${!var}
        - ${arr[@]}
    transform-ops:
        - @U
        - @u
        - @L
        - @Q
        - @E
        - @P
        - @A
        - @K

simplification-target:
